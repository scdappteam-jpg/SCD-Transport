PORT=3000
HOST=0.0.0.0
SCAN_SERVICE_URL=http://localhost:5000/scan
DATA_DIR=
STORAGE_DIR=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Preferred for server-side persistence. Use Supabase's current sb_secret_ key;
# never expose this value in browser code.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-side PostgreSQL connection used only by migrations and maintenance.
# Never expose it as NEXT_PUBLIC_* or commit the real value.
SUPABASE_DB_URL=
# Keep true during the additive transition from app_state to relational tables.
RELATIONAL_MIRROR_ENABLED=true
# One-time document migration source; use only from a trusted admin machine.
LEGACY_APP_ORIGIN=
SUPABASE_STATE_TABLE=app_state
SUPABASE_STATE_ID=scd-transport
LINE_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
BILLING_CC_EMAIL=
N8N_WEBHOOK_KEY=
# Set only after per-user scrypt hashes have been configured. Format JSON:
# {"u_admin_01":"scrypt$<base64-salt>$<base64-hash>"}
SCD_AUTH_PASSWORD_HASHES={}
# Enables bearer-token authentication for every API route except approved webhooks.
SCD_SERVER_AUTH_REQUIRED=false
# Cartrack Fleet API (server-side only; never expose these in browser code)
CARTRACK_BASE_URL=
CARTRACK_USERNAME=
CARTRACK_PASSWORD=
# How often the GPS sync runs. Recommended: 180000 (3 minutes).
CARTRACK_POLL_INTERVAL_MS=180000
# Read-only Cartrack live-data demo. Keep false until an admin explicitly tests it.
CARTRACK_DEMO_ENABLED=false
IMPORT_FEED_DIR=
IMPORT_INTERVAL_MS=7200000
